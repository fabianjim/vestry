{
  "headers": [
    {
      "source": "/:page(login|portfolio|dashboard|transactions|analysis|journal)/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://portfolio-monitor-api-env.eba-2mfreswk.us-east-1.elasticbeanstalk.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "index.html"
    }
  ]
}
